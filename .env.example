# ==============================================================================
# HOSTEL CANTEEN POS — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env.local and fill in your credentials.
# IMPORTANT: Never commit .env.local or real secret keys to GitHub.
# NOTE: No payment gateway API keys (Razorpay, Cashfree, PhonePe, etc.) are used.
#       All Cash & UPI payments and UTR references are recorded manually.
# ==============================================================================

# 1. Supabase Configuration (Required for Supabase PostgreSQL + Supabase Auth mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-Only Secret Key — NEVER prefix with NEXT_PUBLIC_ or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Local Admin Authentication & Session Security (Used for server session signing & local DB mode)
ADMIN_DEFAULT_EMAIL=admin@hostelcanteen.local
ADMIN_DEFAULT_PASSWORD=ChangeThisStrongPassword!2026
ADMIN_DEFAULT_NAME=Hostel Canteen Admin
SESSION_SECRET=replace-with-a-64-char-random-hex-secret-key-in-production

# 3. Application Environment & Timezone
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Hostel Canteen POS"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# 4. Seed Sample Data on Empty Local Dev Database ("true" only for development testing, "false" in production)
SEED_DEV_SAMPLE_DATA=true
